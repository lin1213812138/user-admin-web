# 前端部署路径：与 prod 一致，test 构建同样托管在 /tms-user/ 下（必须以 / 结尾）。
# 注意：pnpm dev 也使用 --mode test，本地开发地址因此变为 http://localhost:9111/tms-user/
VITE_BASE_URL=/tms/

# backend service base url, test environment
VITE_SERVICE_BASE_URL=http://192.168.0.101:15001/tms/api/v1/web

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`
