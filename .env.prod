# 前端部署路径：线上由 tms-user 后端静态托管在 /tms-user/ 下，
# 故 prod 构建的资源前缀必须是 /tms-user/（必须以 / 结尾），同时决定 vue-router 的 base。
# 覆盖 .env 里的 VITE_BASE_URL=/
VITE_BASE_URL=/tms-user/

# backend service base url, prod environment
VITE_SERVICE_BASE_URL=http://124.71.223.164:10010

# other backend service base url, prod environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9529"
}`
